<Window x:Class="SmartVol.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartVol Settings" Width="500" Height="640"
        MinWidth="440" MinHeight="480"
        Background="#202024" Foreground="#EDEDEF"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,18,0,2"/>
        </Style>
        <Style x:Key="SectionHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#EDEDEF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7DD3FC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="26,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3A3A41"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="26,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4A4A53"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="22,18,22,12" BorderThickness="0,0,0,1" BorderBrush="#333338">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2563EB" Offset="0"/>
                    <GradientStop Color="#7C3AED" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="SmartVol Settings" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Tune steps, overlay and audio devices." FontSize="12" Foreground="#D8DCFF" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Border DockPanel.Dock="Bottom" Padding="22,12" BorderThickness="0,1,0,0" BorderBrush="#333338" Background="#1B1B1F">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="OnCancel"/>
                <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSave"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,4,22,16">
            <StackPanel>
                <TextBlock Text="Volume" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Volume step per key press" Style="{StaticResource RowLabel}"/>
                    <TextBlock x:Name="StepValueText" Text="5%" Style="{StaticResource RowValue}" Grid.Column="1"/>
                </Grid>
                <Slider x:Name="StepSlider" Minimum="1" Maximum="20" TickFrequency="1"
                        IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="OnStepChanged"/>

                <TextBlock Text="Overlay" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="How long the overlay stays visible" Style="{StaticResource RowLabel}"/>
                    <TextBlock x:Name="DurationValueText" Text="1300 ms" Style="{StaticResource RowValue}" Grid.Column="1"/>
                </Grid>
                <Slider x:Name="DurationSlider" Minimum="500" Maximum="4000" TickFrequency="100"
                        IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="OnDurationChanged"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Overlay opacity" Style="{StaticResource RowLabel}"/>
                    <TextBlock x:Name="OpacityValueText" Text="92%" Style="{StaticResource RowValue}" Grid.Column="1"/>
                </Grid>
                <Slider x:Name="OpacitySlider" Minimum="50" Maximum="100" TickFrequency="1"
                        IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="OnOpacityChanged"/>

                <TextBlock Text="Startup" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="StartupCheck" Content="Run SmartVol when Windows starts"
                          Foreground="#EDEDEF" FontSize="12.5" Margin="0,6,0,0"/>

                <TextBlock Text="Audio devices" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Uncheck devices to hide them from the tray menu. Changes apply instantly."
                           Style="{StaticResource SectionHint}"/>
                <Border CornerRadius="10" BorderThickness="1" BorderBrush="#3A3A41" Background="#26262B" Padding="6">
                    <ListBox x:Name="DeviceList" Background="Transparent" BorderThickness="0"
                             Foreground="#EDEDEF" MaxHeight="190"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Visible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Foreground="#EDEDEF" FontSize="12.5" Margin="2"
                                          Checked="OnDeviceToggled" Unchecked="OnDeviceToggled">
                                    <CheckBox.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                                            <Border CornerRadius="4" Background="#2563EB" Margin="8,0,0,0" Padding="6,1"
                                                    Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="DEFAULT" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                    </CheckBox.Content>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock Text="Hotkeys" Style="{StaticResource SectionHeader}"/>
                <TextBlock Style="{StaticResource SectionHint}">
                    Click a shortcut, then press the new keys — any combination of Ctrl, Shift, Alt, Win (left or right) plus any key. Esc cancels.
                </TextBlock>
                <Border CornerRadius="10" BorderThickness="1" BorderBrush="#3A3A41" Background="#26262B" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="App volume up" FontSize="12.5" Foreground="#EDEDEF" VerticalAlignment="Center" Margin="0,4"/>
                        <Button x:Name="AppUpButton" Tag="AppUp" Grid.Column="1" FontSize="12.5"
                                Style="{StaticResource SecondaryButton}" Margin="0,4" Click="OnHotkeyButtonClick"/>
                        <TextBlock Text="App volume down" Grid.Row="1" FontSize="12.5" Foreground="#EDEDEF" VerticalAlignment="Center" Margin="0,4"/>
                        <Button x:Name="AppDownButton" Tag="AppDown" Grid.Row="1" Grid.Column="1" FontSize="12.5"
                                Style="{StaticResource SecondaryButton}" Margin="0,4" Click="OnHotkeyButtonClick"/>
                        <TextBlock Text="System volume up" Grid.Row="2" FontSize="12.5" Foreground="#EDEDEF" VerticalAlignment="Center" Margin="0,4"/>
                        <Button x:Name="SystemUpButton" Tag="SystemUp" Grid.Row="2" Grid.Column="1" FontSize="12.5"
                                Style="{StaticResource SecondaryButton}" Margin="0,4" Click="OnHotkeyButtonClick"/>
                        <TextBlock Text="System volume down" Grid.Row="3" FontSize="12.5" Foreground="#EDEDEF" VerticalAlignment="Center" Margin="0,4"/>
                        <Button x:Name="SystemDownButton" Tag="SystemDown" Grid.Row="3" Grid.Column="1" FontSize="12.5"
                                Style="{StaticResource SecondaryButton}" Margin="0,4" Click="OnHotkeyButtonClick"/>
                    </Grid>
                </Border>
                <TextBlock Style="{StaticResource SectionHint}" Margin="0,6,0,0">
                    Tip: keep at least one modifier so normal typing is never blocked. Only the exact combination is captured — everything else keeps working.
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
